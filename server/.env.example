# Sealcleaning-backend — configuratie. Kopieer naar .env en vul in. Nooit committen.
# Sleutels genereren: node server/cli.js gen-key

# Adressen
PUBLIC_BASE_URL=https://api.sealcleaning.nl
SITE_ORIGINS=https://sealcleaning.nl,https://www.sealcleaning.nl
API_DOMAIN=api.sealcleaning.nl

# Beveiliging (verplicht in productie)
COOKIE_SECURE=true
REQUIRE_TOTP=true
TRUST_PROXY=true
IP_HASH_SECRET=
TERMS_VERSION=voorwaarden-concept-2026-10-10

# Back-ups (versleuteld, AES-256-GCM). Bewaar BACKUP_KEY ook buiten de server (wachtwoordkluis).
BACKUP_KEY=
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# SEAL_BACKUP_DIR=/backups

# E-mail (leeg = mails blijven in de wachtrij in het beheer; niet operationeel)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
STAFF_NOTIFY_EMAIL=

# Online betalen (leeg = niet operationeel; klant krijgt betaalinstructie per bankoverschrijving)
MOLLIE_API_KEY=
